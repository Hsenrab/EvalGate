{
  "behavior": {
    "name": "significant_decisions"
  },
  "behavior_file": "behavior.txt",
  "context_file": "context.txt",
  "output_folder": "../../outputs/significant-decisions-test-set",
  "pipeline": {
    "systematize": {
      "model": {
        "name": "azure/gpt5_series/${EVALGATE_AZURE_DEPLOYMENT}",
        "max_tokens": 10000
      },
      "behavior_category_count": 5,
      "web_search": false
    },
    "test_set": {
      "prompt": {
        "sample_size": 10,
        "model": {
          "name": "azure/gpt5_series/${EVALGATE_AZURE_DEPLOYMENT}",
          "max_tokens": 3000
        },
        "timeout_s": 300,
        "sampling": {
          "method": "stratified",
          "stratify_by": ["behavior"]
        }
      }
    },
    "judge": {
      "model": {
        "name": "azure/gpt5_series/${EVALGATE_AZURE_DEPLOYMENT}",
        "max_tokens": 12000
      },
      "n": 1
    }
  }
}
